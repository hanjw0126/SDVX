<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VoltexMate" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.VoltexMate.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lavender</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.VoltexMate</item>
    </style>
</resources>
